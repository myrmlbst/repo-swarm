ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Embeddings for the RAG layer (agents/src/lib/rag/) — https://www.voyageai.com
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-3

# Same Supabase project as api/.env — the RAG layer stores/searches chunks in
# the rag_chunks table (supabase/migrations/0002_rag_pgvector.sql).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same Upstash Redis as api/.env — caches code_agent's facts per commit SHA
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
