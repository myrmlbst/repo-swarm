{
  "name": "repo-swarm-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agent layer for Repo Swarm (orchestrator + five specialist agents). Runnable standalone, without the api/ service.",
  "scripts": {
    "dev": "tsx src/runner.ts",
    "worker": "tsx src/worker.ts",
    "seed-knowledge": "tsx scripts/seedKnowledge.ts",
    "eval": "tsx eval/run.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=spec 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/redis": "^1.38.4",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
